VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local portfolio dashboard bridge.
# Keep real tokens in .env.local only. The bridge reads .env.local directly.
VITE_PORTFOLIO_BRIDGE_BASE_URL=

# Hyperliquid read-only wallet address. A master address also pulls subaccounts.
PORTFOLIO_HYPERLIQUID_MASTER_ADDRESS=

# IBKR Flex Web Service is the default IBKR source because it does not create
# a competing brokerage session.
IBKR_SOURCE_MODE=flex
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_QUERY_IDS=
IBKR_FLEX_BASE_CURRENCY=

# If you need separate Flex queries for separate IBKR accounts, use indexed
# entries. TOKEN can be omitted on indexed entries when they share IBKR_FLEX_TOKEN.
IBKR_FLEX_ACCOUNT_1_LABEL=
IBKR_FLEX_ACCOUNT_1_FILTER_ID=
IBKR_FLEX_ACCOUNT_1_QUERY_ID=
IBKR_FLEX_ACCOUNT_1_QUERY_IDS=
IBKR_FLEX_ACCOUNT_1_TOKEN=
IBKR_FLEX_ACCOUNT_1_BASE_CURRENCY=
IBKR_FLEX_ACCOUNT_2_LABEL=
IBKR_FLEX_ACCOUNT_2_FILTER_ID=
IBKR_FLEX_ACCOUNT_2_QUERY_ID=
IBKR_FLEX_ACCOUNT_2_QUERY_IDS=
IBKR_FLEX_ACCOUNT_2_TOKEN=
IBKR_FLEX_ACCOUNT_2_BASE_CURRENCY=

# Set false to keep IBKR positions in instrument currency instead of converting
# by fxRateToBase from the Flex report.
IBKR_FLEX_CONVERT_TO_BASE=true
